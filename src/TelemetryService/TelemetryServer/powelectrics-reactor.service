[Unit]
Description=Powelectrics Reactor Service

[Service]
Type=notify
WorkingDirectory= /opt/powelectrics/telemetry-server/
ExecStart=/usr/bin/dotnet /opt/powelectrics/telemetry-server/TelemetryServer.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
SyslogIdentifier=telemetry
Environment=DOTNET_ENVIRONMENT=Staging
User=www-data

[Install]
WantedBy=multi-user.target