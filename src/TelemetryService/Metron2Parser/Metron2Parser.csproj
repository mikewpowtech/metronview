<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Antlr4 Include="Metron2.g4">
      <CustomToolNamespace>Metron2Parser</CustomToolNamespace>
      <Listener>True</Listener>
      <Visitor>True</Visitor>
      <OutputType>CSharp</OutputType>
      <Package>Metron2Parser</Package>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.10.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metron2Configuration\Metron2Configuration.csproj" />
  </ItemGroup>
</Project>
